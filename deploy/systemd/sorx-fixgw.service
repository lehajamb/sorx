[Unit]
Description=SORX northbound FIX compatibility gateway
After=sorxd.service
Requires=sorxd.service

[Service]
Type=simple
User=sorx-fix
Group=sorx-fix
ExecStartPre=/usr/bin/sorx-fixgw --check-config /etc/sorx/startup.yaml
ExecStart=/usr/bin/sorx-fixgw --config /etc/sorx/startup.yaml
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sorx/fix /var/log/sorx /run/sorx
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=sorx.target
